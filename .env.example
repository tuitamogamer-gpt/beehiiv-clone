# Local: copy to .env (ignored by git), fill values privately. Never use VITE_ for secrets.
# Production: set these in Vercel Project > Settings > Environment Variables.
APP_URL=http://localhost:5173
# Generate a persistent value: openssl rand -hex 32
SESSION_SECRET=
# Production requires a PostgreSQL connection, preferably the provider's pooled SSL URL.
# Empty DATABASE_URL uses SQLite locally ONLY; production fails closed.
DATABASE_URL=
SQLITE_PATH=.data/newsletter.sqlite
API_PORT=3001

# Run db:bootstrap once, then remove ADMIN_PASSWORD from your environment.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
PUBLICATION_NAME=

# Sending + authentication email. Verify your sender and DNS ownership first.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_FROM=
# Set a stable independent secret so newsletter unsubscribe links survive session-secret rotation.
UNSUBSCRIBE_SECRET=

# Schedule /api/jobs/run every minute with Authorization: Bearer CRON_SECRET,
# or run npm run worker continuously on an always-on host.
CRON_SECRET=
# Set true only after the external scheduler or continuous worker is running.
SCHEDULER_ENABLED=false

# Stripe test-mode keys first. Endpoint: /api/webhooks/stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Turnstile, required for public signup in production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Private Vercel Blob store (images optimized; uploads currently limited to 4 MB).
BLOB_READ_WRITE_TOKEN=

# Optional AI text API. Usage is billed to your account.
OPENAI_API_KEY=
